---
import { buttonVariants } from "@/components/ui/button";
import { ui } from "../lib/copy";
import { barePath, localePath, locales, type Locale } from "../lib/locale";
import { whatsappHref } from "../lib/site";
import Icons from "./Icons.astro";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const c = ui(locale);
const bare = barePath(Astro.url.pathname);
const search = Astro.url.search;
const links = [
	["/about", c.nav.about],
	["/members", c.nav.members],
	["/news", c.nav.news],
	["/membership", c.nav.membership],
	["/contact", c.nav.contact],
] as const;

function active(href: string) {
	return bare === href || bare.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-40 bg-brand text-white">
	<div class="mx-auto flex h-18 max-w-6xl items-center gap-3 px-5">
		<a href={localePath(locale)} class="flex shrink-0 items-center bg-white px-1.5 py-0.5" aria-label="IDCA — Indonesia Divetourism Company Association">
			<img src="/brand/logo-mark.png" alt="" width="440" height="260" class="h-auto w-28" />
		</a>
		<nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="IDCA">
			{
				links.map(([href, label]) => (
					<a
						href={localePath(locale, href)}
						aria-current={active(href) ? "page" : undefined}
						class:list={[
							"inline-flex min-h-11 items-center border-b-2 px-2.5 text-sm font-medium",
							active(href) ? "border-white text-white" : "border-transparent text-white/80 hover:text-white",
						]}
					>
						{label}
					</a>
				))
			}
		</nav>
		<div class="ml-auto flex items-center gap-2 lg:ml-3">
			<button
				type="button"
				data-theme-toggle
				aria-pressed="true"
				data-to-light={c.themeToLight}
				data-to-dark={c.themeToDark}
				class="inline-flex size-11 items-center justify-center rounded-full border border-white/40 text-white hover:bg-white/15"
			>
				<Icons name="sun" class="size-5 [[data-theme=light]_&]:hidden" />
				<Icons name="moon" class="hidden size-5 [[data-theme=light]_&]:block" />
				<span class="sr-only">{c.themeToLight}</span>
			</button>
			<a href={whatsappHref} aria-label={c.whatsapp} class="inline-flex size-11 items-center justify-center rounded-full bg-[#22c55e] text-white shadow-md transition-colors hover:bg-[#16a34a] lg:hidden">
				<Icons name="whatsapp" />
			</a>
			<div class="hidden overflow-hidden rounded-full border border-white/40 sm:flex" role="group" aria-label={c.language}>
				{
					locales.map((item) => (
						<a
							href={`${localePath(item, bare)}${search}`}
							hreflang={item}
							lang={item}
							data-locale={item}
							aria-current={item === locale ? "true" : undefined}
							class:list={[
								"inline-flex min-h-11 min-w-11 items-center justify-center",
								item === locale ? "bg-white" : "hover:bg-white/15",
							]}
						>
							<Icons name={item === "en" ? "flag-us" : "flag-id"} class="h-4 w-6 rounded-[2px] shadow-sm ring-1 ring-black/10" />
							<span class="sr-only">{item === "en" ? "English" : "Bahasa Indonesia"}</span>
						</a>
					))
				}
			</div>
			<div class="hidden lg:block">
				<a href={localePath(locale, "/login")} class={buttonVariants({ variant: "white", className: "h-12 px-4" })}>
					{c.nav.login}
				</a>
			</div>
			<button
				type="button"
				class:list={[buttonVariants({ variant: "ghost", size: "icon", className: "size-12 text-white hover:bg-white/15 hover:text-white lg:hidden" })]}
				data-menu-button
				data-open={c.openMenu}
				data-close={c.closeMenu}
				aria-expanded="false"
				aria-controls="site-menu"
			>
				<span class="sr-only">{c.openMenu}</span>
				<Icons name="menu" />
			</button>
		</div>
	</div>
	<div id="site-menu" class="hidden border-t border-white/20 bg-brand lg:hidden" data-menu>
		<nav class="mx-auto flex max-w-6xl flex-col px-5 py-2" aria-label="IDCA">
			{
				links.map(([href, label]) => (
					<a
						href={localePath(locale, href)}
						aria-current={active(href) ? "page" : undefined}
						class:list={["border-b border-white/20 py-3 text-lg text-white", active(href) ? "font-semibold" : "text-white/80"]}
					>
						{label}
					</a>
				))
			}
			<a href={localePath(locale, "/login")} class:list={["mt-4", buttonVariants({ variant: "white", className: "h-12" })]}>
				{c.nav.login}
			</a>
			<div class="my-4 flex overflow-hidden rounded-full border border-white/40" role="group" aria-label={c.language}>
				{
					locales.map((item) => (
						<a
							href={`${localePath(item, bare)}${search}`}
							hreflang={item}
							lang={item}
							data-locale={item}
							aria-current={item === locale ? "true" : undefined}
							class:list={[
								"inline-flex min-h-11 flex-1 items-center justify-center",
								item === locale ? "bg-white" : "text-white hover:bg-white/15",
							]}
						>
							<Icons name={item === "en" ? "flag-us" : "flag-id"} class="h-4 w-6 rounded-[2px] shadow-sm ring-1 ring-black/10" />
							<span class="sr-only">{item === "en" ? "English" : "Bahasa Indonesia"}</span>
						</a>
					))
				}
			</div>
		</nav>
	</div>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
	const menu = document.querySelector<HTMLElement>("[data-menu]");
	const label = button?.querySelector(".sr-only");
	const openText = button?.dataset.open ?? "Open menu";
	const closeText = button?.dataset.close ?? "Close menu";
	function setOpen(open: boolean) {
		menu?.classList.toggle("hidden", !open);
		button?.setAttribute("aria-expanded", String(open));
		if (label) label.textContent = open ? closeText : openText;
	}
	button?.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
	const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
	const themeLabel = themeToggle?.querySelector(".sr-only");
	function applyTheme(theme: string) {
		document.documentElement.dataset.theme = theme;
		const toLight = theme !== "light";
		themeToggle?.setAttribute("aria-pressed", String(toLight));
		if (themeLabel) themeLabel.textContent = toLight ? themeToggle?.dataset.toLight ?? "" : themeToggle?.dataset.toDark ?? "";
	}
	applyTheme(document.documentElement.dataset.theme === "light" ? "light" : "dark");
	themeToggle?.addEventListener("click", () => {
		const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
		applyTheme(next);
		document.cookie = `idca-theme=${next};path=/;max-age=${60 * 60 * 24 * 365};samesite=lax`;
	});
	const year = 60 * 60 * 24 * 365;
	document.querySelectorAll<HTMLAnchorElement>("[data-locale]").forEach((link) => {
		link.addEventListener("click", () => {
			document.cookie = `idca-locale=${link.dataset.locale};path=/;max-age=${year};samesite=lax`;
		});
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") setOpen(false);
	});
</script>
