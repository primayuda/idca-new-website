---
interface Props {
	subject: string;
	status: string;
	submit: string;
	required: string;
	emailInvalid: string;
}
const { subject, status, submit, required, emailInvalid } = Astro.props;
---

<form class="space-y-4" novalidate data-mail-form data-subject={subject} data-status={status} data-required={required} data-email-invalid={emailInvalid}>
	<slot />
	<button type="submit" class="inline-flex min-h-11 items-center bg-reef px-5 text-sm font-semibold text-paper hover:bg-reef-bright">{submit}</button>
	<p class="hidden text-sm leading-relaxed" data-mail-status role="status"></p>
</form>

<script>
	const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
	for (const form of document.querySelectorAll<HTMLFormElement>("[data-mail-form]")) {
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const status = form.querySelector<HTMLElement>("[data-mail-status]");
			let valid = true;
			for (const field of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("input, textarea, select")) {
				const message = form.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
				field.removeAttribute("aria-invalid");
				if (message) message.textContent = "";
				const value = field.value.trim();
				const missing = field.required && !value;
				const badEmail = field.type === "email" && value !== "" && !emailPattern.test(value);
				if (missing || badEmail) {
					valid = false;
					field.setAttribute("aria-invalid", "true");
					if (message) message.textContent = badEmail ? (form.dataset.emailInvalid ?? "") : (form.dataset.required ?? "");
				}
			}
			if (!valid) {
				form.querySelector<HTMLElement>("[aria-invalid='true']")?.focus();
				return;
			}
			const lines = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("input, textarea, select")]
				.filter((field) => field.name)
				.map((field) => `${field.name}: ${field.value.trim()}`);
			const href = `mailto:infopuwsi@gmail.com?subject=${encodeURIComponent(form.dataset.subject ?? "IDCA")}&body=${encodeURIComponent(lines.join("\n"))}`;
			if (status) {
				status.textContent = form.dataset.status ?? "";
				status.classList.remove("hidden");
			}
			window.location.href = href;
		});
	}
</script>
