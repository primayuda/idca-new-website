---
import { buttonVariants } from "@/components/ui/button";
import Base from "../layouts/Base.astro";
import { ui } from "../lib/copy";
import { localePath, type Locale } from "../lib/locale";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const c = ui(locale);
---

<Base locale={locale} title={c.notFound.title} description={c.notFound.body}>
	<div class="mx-auto max-w-3xl px-5 py-24">
		<h1 class="font-display text-5xl leading-tight">{c.notFound.title}</h1>
		<p class="mt-4 text-lg text-muted-foreground">{c.notFound.body}</p>
		<a href={localePath(locale)} class:list={["mt-8", buttonVariants({ className: "h-12 px-5" })]}>{c.notFound.home}</a>
	</div>
</Base>
