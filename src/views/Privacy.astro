---
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { ui } from "../lib/copy";
import type { Locale } from "../lib/locale";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const c = ui(locale);
---

<Base locale={locale} title={c.privacy.title} description={c.privacy.lede}>
	<PageHeader eyebrow={c.footer.privacy} title={c.privacy.title} lede={c.privacy.lede} />
	<div class="mx-auto max-w-3xl space-y-8 px-5 py-14">
		{
			c.privacy.sections.map(([heading, body]) => (
				<section>
					<h2 class="font-display text-3xl">{heading}</h2>
					<p class="mt-3 text-lg leading-relaxed">{body}</p>
				</section>
			))
		}
	</div>
</Base>
