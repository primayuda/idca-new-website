---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { ui } from "../lib/copy";
import { img, str } from "../lib/fields";
import { labelFor, localePath, regionList, regionOptions, typeOptions, type Locale } from "../lib/locale";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const c = ui(locale);
const { entries } = await getEmDashCollection("members", { locale, orderBy: { title: "asc" } });
---

<Base locale={locale} title={c.directory.title} description={c.directory.lede}>
	<PageHeader eyebrow={c.nav.members} title={c.directory.title} lede={c.directory.lede} />
	<div class="mx-auto max-w-6xl px-5 py-12">
		<form class="grid gap-4 border border-line bg-foam p-4 sm:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)] sm:items-end" role="search" data-directory>
			<div>
				<label for="member-search" class="mb-1.5 block text-sm font-medium">{c.directory.searchLabel}</label>
				<input id="member-search" type="search" placeholder={c.directory.searchPlaceholder} class="w-full min-h-11 border border-line bg-paper px-3 text-base" />
			</div>
			<div>
				<label for="member-region" class="mb-1.5 block text-sm font-medium">{c.directory.regionLabel}</label>
				<select id="member-region" class="w-full min-h-11 border border-line bg-paper px-3 text-base">
					<option value="">{c.directory.allRegions}</option>
					{regionOptions.map((region) => <option value={region}>{labelFor(locale, region, "region")}</option>)}
				</select>
			</div>
			<div>
				<label for="member-type" class="mb-1.5 block text-sm font-medium">{c.directory.typeLabel}</label>
				<select id="member-type" class="w-full min-h-11 border border-line bg-paper px-3 text-base">
					<option value="">{c.directory.allTypes}</option>
					{typeOptions.map((type) => <option value={type}>{labelFor(locale, type, "type")}</option>)}
				</select>
			</div>
		</form>
		<p class="mt-6 text-sm text-muted" data-count>{c.directory.count(entries.length)}</p>
		<ul class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-list>
			{
				entries.map((member) => {
					const regions = Array.isArray(member.data.regions) ? member.data.regions.join("|") : "";
					return (
						<li data-name={String(member.data.title).toLowerCase()} data-regions={regions} data-type={String(member.data.operation_type ?? "")}>
							<a href={localePath(locale, `/members/${member.data.slug}`)} class="group flex h-full flex-col border border-line bg-paper">
								<div class="relative aspect-[16/10] overflow-hidden bg-foam">
									{img(member.data.featured_image) && <Image image={img(member.data.featured_image)} class="h-full w-full object-cover" />}
								</div>
								<div class="flex flex-1 flex-col p-4">
									<h2 class="font-display text-2xl leading-tight group-hover:text-reef">{member.data.title}</h2>
									<p class="mt-2 text-sm font-medium text-reef">{regionList(locale, member.data.regions)}</p>
									<p class="mt-1 text-sm text-muted">{labelFor(locale, str(member.data.operation_type), "type")}</p>
									<span class="mt-4 text-sm font-semibold">{c.directory.viewProfile}</span>
								</div>
							</a>
						</li>
					);
				})
			}
		</ul>
		<div class="mt-6 hidden border border-dashed border-line px-6 py-14 text-center" data-empty>
			<h2 class="font-display text-3xl">{c.directory.emptyTitle}</h2>
			<p class="mx-auto mt-3 max-w-md text-muted">{c.directory.emptyBody}</p>
			<button type="button" class="mt-6 inline-flex min-h-11 items-center bg-ink px-4 text-sm font-semibold text-paper" data-clear>{c.directory.clear}</button>
		</div>
	</div>
</Base>

<script define:vars={{ one: c.directory.count(1), many: c.directory.count(2).replace("2", "{n}") }}>
	const root = document.querySelector("[data-directory]");
	const search = document.querySelector("#member-search");
	const region = document.querySelector("#member-region");
	const type = document.querySelector("#member-type");
	const items = [...document.querySelectorAll("[data-list] li")];
	const empty = document.querySelector("[data-empty]");
	const count = document.querySelector("[data-count]");
	const params = new URLSearchParams(location.search);
	if (search && params.get("q")) search.value = params.get("q");
	if (region && params.get("region")) region.value = params.get("region");
	if (type && params.get("type")) type.value = params.get("type");

	function label(n) {
		return n === 1 ? one : many.replace("{n}", String(n));
	}
	function apply(push) {
		const q = search.value.trim().toLowerCase();
		const regionValue = region.value;
		const typeValue = type.value;
		let shown = 0;
		for (const item of items) {
			const regions = (item.dataset.regions || "").split("|").filter(Boolean);
			const match =
				(!q || item.dataset.name.includes(q) || regions.some((value) => value.toLowerCase().includes(q))) &&
				(!regionValue || regions.includes(regionValue)) &&
				(!typeValue || item.dataset.type === typeValue);
			item.hidden = !match;
			if (match) shown += 1;
		}
		empty.classList.toggle("hidden", shown !== 0);
		count.textContent = label(shown);
		const next = new URLSearchParams();
		if (q) next.set("q", search.value.trim());
		if (regionValue) next.set("region", regionValue);
		if (typeValue) next.set("type", typeValue);
		const qs = next.toString();
		if (push) history.replaceState(null, "", qs ? `${location.pathname}?${qs}` : location.pathname);
	}
	let timer;
	function schedule() {
		clearTimeout(timer);
		timer = setTimeout(() => apply(true), 250);
	}
	root?.addEventListener("submit", (event) => event.preventDefault());
	search?.addEventListener("input", schedule);
	region?.addEventListener("change", () => apply(true));
	type?.addEventListener("change", () => apply(true));
	document.querySelector("[data-clear]")?.addEventListener("click", () => {
		search.value = "";
		region.value = "";
		type.value = "";
		apply(true);
		search.focus();
	});
	document.addEventListener("keydown", (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
			event.preventDefault();
			search?.focus();
		}
	});
	apply(false);
</script>
