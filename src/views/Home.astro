---
import { buttonVariants } from "@/components/ui/button";
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { ui } from "../lib/copy";
import { img, str } from "../lib/fields";
import { formatDate, labelFor, localePath, regionList, regionOptions, type Locale } from "../lib/locale";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const c = ui(locale);
const [{ entries: members }, { entries: activities }] = await Promise.all([
	getEmDashCollection("members", { locale, orderBy: { title: "asc" } }),
	getEmDashCollection("activities", { locale, orderBy: { event_date: "desc" }, limit: 2 }),
]);
const featured = members.find((member) => member.data.featured) ?? members[0];
const rest = members.filter((member) => member !== featured).slice(0, 4);
const [lead, next] = activities;
const title = locale === "id" ? "IDCA — Perkumpulan Usaha Wisata Selam Indonesia" : "IDCA — Indonesia Divetourism Company Association";
---

<Base locale={locale} title={title} description={c.hero.lede}>
	<section class="bg-brand text-white">
		<div class="grid lg:min-h-[calc(100vh-4.5rem)] lg:grid-cols-12">
			<div class="flex p-4 sm:p-6 lg:col-span-7 lg:py-6 lg:pr-0 lg:pl-6">
				<div class="relative min-h-[34vh] flex-1 overflow-hidden rounded-2xl sm:min-h-[46vh]">
					<img
						src="/photos/hero.jpg"
						alt={locale === "id" ? "Penyelam di atas terumbu" : "Diver above a reef"}
						class="absolute inset-0 h-full w-full object-cover"
						width="2000"
						height="1333"
					/>
				</div>
			</div>
			<div class="flex flex-col justify-center px-6 py-12 sm:px-10 lg:col-span-5 lg:px-12 lg:py-16">
				<div class="max-w-lg">
					<p class="text-xs font-semibold uppercase tracking-[0.16em] text-sand">{c.hero.eyebrow}</p>
					<h1 class="mt-4 font-display text-[2.55rem] leading-[1.05] text-balance sm:text-5xl">{c.hero.title}</h1>
					<p class="mt-5 text-base leading-relaxed text-sand">{c.hero.lede}</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a href={localePath(locale, "/membership")} class={buttonVariants({ variant: "secondary", className: "h-12 bg-white px-5 text-primary hover:bg-white/90" })}>{c.hero.join}</a>
						<a href={localePath(locale, "/login")} class={buttonVariants({ variant: "outline", className: "h-12 border-white/50 bg-transparent px-5 text-white hover:bg-white/15 hover:text-white" })}>{c.hero.login}</a>
					</div>
					<ul class="mt-10 border-y border-white/15">
						{
							[
								[c.hero.membersValue, c.hero.membersLabel],
								[c.hero.voiceValue, c.hero.voiceLabel],
								[c.hero.termValue, c.hero.termLabel],
							].map(([value, label]) => (
								<li class="flex items-baseline justify-between gap-4 border-b border-white/15 py-3 last:border-b-0">
									<span class="font-display text-3xl">{value}</span>
									<span class="max-w-[14rem] text-right text-sm leading-snug text-sand">{label}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<nav aria-label={c.regionsLabel} class="border-b border-line bg-foam">
		<div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center">
			<p class="shrink-0 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">{c.regionsLabel}</p>
			<ul class="flex flex-wrap gap-x-5 gap-y-1">
				{
					regionOptions.map((region) => (
						<li>
							<a href={`${localePath(locale, "/members")}?region=${encodeURIComponent(region)}`} class="inline-flex min-h-11 items-center text-sm font-medium hover:text-reef">
								{labelFor(locale, region, "region")}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</nav>

	<section class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:py-24">
		<div>
			<p class="text-xs font-semibold uppercase tracking-[0.16em] text-reef">{c.objectives.eyebrow}</p>
			<h2 class="mt-3 font-display text-4xl leading-tight text-balance">{c.objectives.title}</h2>
			<p class="mt-4 text-lg leading-relaxed text-muted-foreground">{c.objectives.lede}</p>
		</div>
		<ol>
			{
				c.objectives.items.map(([heading, body], index) => (
					<li class="grid grid-cols-[3.5rem_minmax(0,1fr)] gap-3 border-t border-line py-5">
						<span class="font-display text-2xl text-reef">{String(index + 1).padStart(2, "0")}</span>
						<div>
							<h3 class="font-display text-2xl">{heading}</h3>
							<p class="mt-1 leading-relaxed text-muted-foreground">{body}</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section class="border-y border-line bg-foam">
		<div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-2 lg:py-24">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.16em] text-reef">{c.association.eyebrow}</p>
				<h2 class="mt-3 font-display text-4xl leading-tight">{c.association.title}</h2>
				<div class="mt-5 space-y-4 text-lg leading-relaxed">
					{c.association.body.map((paragraph) => <p>{paragraph}</p>)}
				</div>
				<a href={localePath(locale, "/about")} class="mt-6 inline-flex min-h-11 items-center text-sm font-semibold text-reef underline decoration-reef/40 underline-offset-4">{c.association.more}</a>
			</div>
			<blockquote class="rounded-2xl bg-brand px-6 py-8 text-white sm:px-8">
				<p class="font-display text-2xl leading-snug text-balance">“{c.association.quote}”</p>
				<footer class="mt-6 text-sm text-sand">{c.association.quoteBy}</footer>
			</blockquote>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-5 py-16 lg:py-24">
		<div class="max-w-2xl">
			<p class="text-xs font-semibold uppercase tracking-[0.16em] text-reef">{c.directoryHome.eyebrow}</p>
			<h2 class="mt-3 font-display text-4xl leading-tight">{c.directoryHome.title}</h2>
			<p class="mt-4 text-lg leading-relaxed text-muted-foreground">{c.directoryHome.lede}</p>
		</div>
		{
			featured ? (
				<div class="mt-10 grid gap-8 lg:grid-cols-12">
					<a href={localePath(locale, `/members/${featured.data.slug}`)} class="group lg:col-span-7">
						<div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-foam">
							{img(featured.data.featured_image) && <Image image={img(featured.data.featured_image)} class="h-full w-full object-cover" />}
						</div>
						<h3 class="mt-4 font-display text-3xl group-hover:text-reef">{featured.data.title}</h3>
						<p class="mt-1 text-sm text-muted-foreground">
							{regionList(locale, featured.data.regions)} · {labelFor(locale, str(featured.data.operation_type), "type")}
						</p>
					</a>
					<ul class="border-t border-line lg:col-span-5">
						{rest.map((member) => (
							<li class="border-b border-line">
								<a href={localePath(locale, `/members/${member.data.slug}`)} class="group flex items-center gap-4 py-4">
									<span class="relative h-16 w-16 shrink-0 overflow-hidden rounded-xl bg-foam">
										{img(member.data.featured_image) && <Image image={img(member.data.featured_image)} class="h-full w-full object-cover" alt="" />}
									</span>
									<span class="min-w-0">
										<span class="block font-medium group-hover:text-reef">{member.data.title}</span>
										<span class="mt-0.5 block text-sm text-muted-foreground">{regionList(locale, member.data.regions)}</span>
									</span>
									<span aria-hidden="true" class="ml-auto text-muted-foreground">→</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			) : (
				<p class="mt-8 text-muted-foreground">{c.directoryHome.empty}</p>
			)
		}
		<a href={localePath(locale, "/members")} class:list={["mt-8", buttonVariants({ className: "h-12 px-5" })]}>{c.directoryHome.viewAll}</a>
	</section>

	<section class="border-t border-line bg-foam">
		<div class="mx-auto max-w-6xl px-5 py-16 lg:py-24">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div class="max-w-2xl">
					<p class="text-xs font-semibold uppercase tracking-[0.16em] text-reef">{c.newsHome.eyebrow}</p>
					<h2 class="mt-3 font-display text-4xl leading-tight">{c.newsHome.title}</h2>
					<p class="mt-4 text-lg leading-relaxed text-muted-foreground">{c.newsHome.lede}</p>
				</div>
				<a href={localePath(locale, "/news")} class={buttonVariants({ variant: "link", className: "h-12 px-0 text-primary" })}>{c.newsHome.all}</a>
			</div>
			{
				lead ? (
					<div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)]">
						<article>
							<a href={localePath(locale, `/news/${lead.data.slug}`)} class="group">
								<div class="relative aspect-[16/9] overflow-hidden rounded-2xl bg-line">
									{img(lead.data.featured_image) && <Image image={img(lead.data.featured_image)} class="h-full w-full object-cover" />}
								</div>
								<p class="mt-4 text-xs font-semibold uppercase tracking-[0.14em] text-reef">
									{labelFor(locale, str(lead.data.category), "category")} · {formatDate(locale, lead.data.event_date)}
								</p>
								<h3 class="mt-2 font-display text-3xl leading-tight group-hover:text-reef">{lead.data.title}</h3>
								<p class="mt-3 max-w-xl leading-relaxed text-muted-foreground">{lead.data.excerpt}</p>
								<span class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold">{c.newsHome.read}</span>
							</a>
						</article>
						{
							next && (
								<article class="border-t border-line pt-6 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
									<a href={localePath(locale, `/news/${next.data.slug}`)} class="group block">
										<p class="text-xs font-semibold uppercase tracking-[0.14em] text-reef">
											{labelFor(locale, str(next.data.category), "category")} · {formatDate(locale, next.data.event_date)}
										</p>
										<h3 class="mt-3 font-display text-2xl leading-tight group-hover:text-reef">{next.data.title}</h3>
										<p class="mt-3 leading-relaxed text-muted-foreground">{next.data.excerpt}</p>
										<span class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold">{c.newsHome.read}</span>
									</a>
								</article>
							)
						}
					</div>
				) : (
					<p class="mt-8 text-muted-foreground">{c.newsHome.empty}</p>
				)
			}
		</div>
	</section>

	<section class="bg-brand text-white">
		<div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-16 sm:flex-row sm:items-end sm:justify-between">
			<div class="max-w-xl">
				<h2 class="font-display text-4xl leading-tight">{c.joinBand.title}</h2>
				<p class="mt-4 leading-relaxed text-sand">{c.joinBand.body}</p>
			</div>
			<a href={localePath(locale, "/membership")} class={buttonVariants({ variant: "secondary", className: "h-12 shrink-0 bg-white px-5 text-primary hover:bg-white/90" })}>{c.joinBand.cta}</a>
		</div>
	</section>
</Base>
