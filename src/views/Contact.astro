---
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import MailForm from "../components/MailForm.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { ui } from "../lib/copy";
import { site, whatsappHref } from "../lib/site";
import type { Locale } from "../lib/locale";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const c = ui(locale);
const control = "h-12 bg-background text-base md:text-base";
---

<Base locale={locale} title={c.contact.title} description={c.contact.lede}>
	<PageHeader eyebrow={c.nav.contact} title={c.contact.title} lede={c.contact.lede} />
	<div class="mx-auto grid max-w-6xl gap-12 px-5 py-14 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
		<address class="space-y-5 not-italic">
			<div>
				<h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-reef">{c.contact.address}</h2>
				<p class="mt-2">{site.street}<br />{site.locality}</p>
			</div>
			<div>
				<h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-reef">{c.contact.email}</h2>
				<p class="mt-2"><a class="underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a></p>
			</div>
			<div>
				<h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-reef">{c.contact.whatsapp}</h2>
				<p class="mt-2"><a class="underline underline-offset-4" href={whatsappHref}>{site.whatsappDisplay}</a></p>
			</div>
			<div>
				<h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-reef">{c.contact.press}</h2>
				<p class="mt-2">{site.pressName}<br /><a class="underline underline-offset-4" href="tel:+6281281197303">{site.pressPhone}</a></p>
			</div>
		</address>
		<section class="rounded-xl bg-card p-5 text-card-foreground ring-1 ring-foreground/10 sm:p-6">
			<h2 class="font-display text-3xl">{c.contact.formTitle}</h2>
			<div class="mt-6">
				<MailForm subject={locale === "id" ? "Pesan untuk sekretariat IDCA" : "Message for the IDCA secretariat"} status={c.contact.status} submit={c.contact.submit} required={c.contact.required} emailInvalid={c.contact.emailInvalid}>
					<div>
						<Label className="mb-1.5" htmlFor="name">{c.contact.name}</Label>
						<Input id="name" name={c.contact.name} required autoComplete="name" className={control} />
						<p id="name-error" class="field-error"><span class="sr-only">Error.</span> <span data-error-text></span></p>
					</div>
					<div>
						<Label className="mb-1.5" htmlFor="email">{c.contact.email}</Label>
						<Input id="email" name={c.contact.email} type="email" required autoComplete="email" className={control} />
						<p id="email-error" class="field-error"><span class="sr-only">Error.</span> <span data-error-text></span></p>
					</div>
					<div>
						<Label className="mb-1.5" htmlFor="topic">{c.contact.topic}</Label>
						<select id="topic" name={c.contact.topic} required class="brand-select bg-background">
							<option value="">{c.membership.choose}</option>
							{c.contact.topics.map((topic) => <option value={topic}>{topic}</option>)}
						</select>
						<p id="topic-error" class="field-error"><span class="sr-only">Error.</span> <span data-error-text></span></p>
					</div>
					<div>
						<Label className="mb-1.5" htmlFor="message">{c.contact.message}</Label>
						<Textarea id="message" name={c.contact.message} required rows={5} className="min-h-32 bg-background text-base md:text-base" />
						<p id="message-error" class="field-error"><span class="sr-only">Error.</span> <span data-error-text></span></p>
					</div>
				</MailForm>
			</div>
		</section>
	</div>
</Base>
