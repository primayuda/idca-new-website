---
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { ui } from "../lib/copy";
import type { Member } from "../../emdash-env";
import { img, str } from "../lib/fields";
import { labelFor, localePath, regionList, type Locale } from "../lib/locale";

interface Props {
	locale: Locale;
	entry: { data: Member };
}
const { locale, entry } = Astro.props;
const c = ui(locale);
const whatsapp = typeof entry.data.whatsapp === "string" ? entry.data.whatsapp.replace(/[^\d]/g, "") : "";
const website = typeof entry.data.website === "string" ? entry.data.website : "";
const email = typeof entry.data.email === "string" ? entry.data.email : "";
---

<Base locale={locale} title={String(entry.data.title)} description={String(entry.data.summary ?? "")}>
	<article>
		{
			img(entry.data.featured_image) && (
				<div class="bg-foam">
					<div class="mx-auto flex h-[42vh] min-h-72 max-w-5xl items-center justify-center px-5 py-8">
						<Image image={img(entry.data.featured_image)} priority class="max-h-full max-w-full object-contain" />
					</div>
				</div>
			)
		}
		<div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 lg:grid-cols-[minmax(0,1fr)_300px]">
			<div>
				<h1 class="font-display text-5xl leading-none">{entry.data.title}</h1>
				<p class="mt-3 text-lg text-muted-foreground">{regionList(locale, entry.data.regions)} · {labelFor(locale, str(entry.data.operation_type), "type")}</p>
				<h2 class="mt-10 font-display text-3xl">{c.profile.about}</h2>
				<p class="mt-4 max-w-2xl text-lg leading-relaxed">{entry.data.summary}</p>
				{entry.data.services && (
					<>
						<h2 class="mt-10 font-display text-3xl">{c.profile.services}</h2>
						<p class="mt-4 max-w-2xl leading-relaxed text-muted-foreground">{entry.data.services}</p>
					</>
				)}
			</div>
			<aside class="h-fit border border-line bg-foam p-5 lg:sticky lg:top-24">
				<h2 class="font-display text-2xl">{c.profile.info}</h2>
				<dl class="mt-4 space-y-3 text-sm">
					<div>
						<dt class="text-muted-foreground">{c.profile.type}</dt>
						<dd class="font-medium">{labelFor(locale, str(entry.data.operation_type), "type")}</dd>
					</div>
					<div>
						<dt class="text-muted-foreground">{c.profile.region}</dt>
						<dd class="font-medium">{regionList(locale, entry.data.regions)}</dd>
					</div>
					{website && (
						<div>
							<dt class="text-muted-foreground">{c.profile.website}</dt>
							<dd><a class="font-medium text-reef underline underline-offset-4" href={website}>{website.replace(/^https?:\/\//, "")}</a></dd>
						</div>
					)}
					{email && (
						<div>
							<dt class="text-muted-foreground">{c.profile.email}</dt>
							<dd><a class="font-medium text-reef underline underline-offset-4" href={`mailto:${email}`}>{email}</a></dd>
						</div>
					)}
					{whatsapp && (
						<div>
							<dt class="text-muted-foreground">{c.profile.whatsapp}</dt>
							<dd><a class="font-medium text-reef underline underline-offset-4" href={`https://wa.me/${whatsapp}`}>{entry.data.whatsapp}</a></dd>
						</div>
					)}
				</dl>
				{!website && !email && !whatsapp && <p class="mt-5 text-sm leading-relaxed text-muted-foreground">{c.profile.note}</p>}
				<a href={localePath(locale, "/members")} class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-reef underline underline-offset-4">{c.profile.back}</a>
			</aside>
		</div>
	</article>
</Base>
