---
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import MailForm from "../components/MailForm.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { ui } from "../lib/copy";
import type { Locale } from "../lib/locale";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const c = ui(locale);
---

<Base locale={locale} title={c.login.title} description={c.login.lede}>
	<PageHeader eyebrow={c.nav.login} title={c.login.title} lede={c.login.lede} />
	<div class="mx-auto max-w-xl px-5 py-14">
		<MailForm subject={c.login.subject} status={c.login.status} submit={c.login.submit} required={c.login.required} emailInvalid={c.login.emailInvalid}>
			<div>
				<Label className="mb-1.5" htmlFor="email">{c.login.email}</Label>
				<Input id="email" name={c.login.email} type="email" required autoComplete="email" className="h-12 bg-background text-base md:text-base" />
				<p id="email-error" class="field-error"><span class="sr-only">Error.</span> <span data-error-text></span></p>
			</div>
		</MailForm>
	</div>
</Base>
