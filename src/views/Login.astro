---
import MailForm from "../components/MailForm.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { ui } from "../lib/copy";
import type { Locale } from "../lib/locale";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const c = ui(locale);
---

<Base locale={locale} title={c.login.title} description={c.login.lede}>
	<PageHeader eyebrow={c.nav.login} title={c.login.title} lede={c.login.lede} />
	<div class="mx-auto max-w-xl px-5 py-14">
		<MailForm subject={c.login.subject} status={c.login.status} submit={c.login.submit} required={c.login.required} emailInvalid={c.login.emailInvalid}>
			<label class="block text-sm font-medium" for="email">{c.login.email}</label>
			<input id="email" name={c.login.email} type="email" required autocomplete="email" class="w-full min-h-11 border border-line bg-paper px-3 text-base" />
			<p class="text-sm text-danger" data-error-for="email"></p>
		</MailForm>
	</div>
</Base>
