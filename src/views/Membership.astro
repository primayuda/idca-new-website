---
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import MailForm from "../components/MailForm.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { ui } from "../lib/copy";
import { labelFor, regionOptions, typeOptions, type Locale } from "../lib/locale";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const c = ui(locale);
const m = c.membership;
const control = "h-12 bg-background text-base md:text-base";
---

<Base locale={locale} title={m.title} description={m.lede}>
	<PageHeader eyebrow={c.nav.membership} title={m.title} lede={m.lede} />
	<div class="mx-auto grid max-w-6xl gap-12 px-5 py-14 lg:grid-cols-2">
		<section>
			<h2 class="font-display text-3xl">{m.privilegesTitle}</h2>
			<ul class="mt-6 space-y-5">
				{
					m.privileges.map(([title, body]) => (
						<li>
							<h3 class="font-display text-2xl">{title}</h3>
							<p class="mt-1 leading-relaxed text-muted-foreground">{body}</p>
						</li>
					))
				}
			</ul>
		</section>
		<section class="rounded-xl bg-card p-5 text-card-foreground ring-1 ring-foreground/10 sm:p-6">
			<h2 class="font-display text-3xl">{m.formTitle}</h2>
			<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{m.formLede}</p>
			<div class="mt-6">
				<MailForm subject={locale === "id" ? "Pendaftaran anggota IDCA" : "IDCA membership application"} status={m.status} submit={m.submit} required={m.required} emailInvalid={m.emailInvalid}>
					<div>
						<Label className="mb-1.5" htmlFor="company">{m.company}</Label>
						<Input id="company" name={m.company} required className={control} />
						<p id="company-error" class="field-error"><span class="sr-only">Error.</span> <span data-error-text></span></p>
					</div>
					<div>
						<Label className="mb-1.5" htmlFor="contact">{m.contact}</Label>
						<Input id="contact" name={m.contact} required autoComplete="name" className={control} />
						<p id="contact-error" class="field-error"><span class="sr-only">Error.</span> <span data-error-text></span></p>
					</div>
					<div>
						<Label className="mb-1.5" htmlFor="email">{m.email}</Label>
						<Input id="email" name={m.email} type="email" required autoComplete="email" className={control} />
						<p id="email-error" class="field-error"><span class="sr-only">Error.</span> <span data-error-text></span></p>
					</div>
					<div>
						<Label className="mb-1.5" htmlFor="phone">{m.phone}</Label>
						<Input id="phone" name={m.phone} type="tel" required autoComplete="tel" className={control} />
						<p id="phone-error" class="field-error"><span class="sr-only">Error.</span> <span data-error-text></span></p>
					</div>
					<div>
						<Label className="mb-1.5" htmlFor="region">{m.region}</Label>
						<select id="region" name={m.region} required class="brand-select bg-background">
							<option value="">{m.choose}</option>
							{regionOptions.map((region) => <option value={labelFor(locale, region, "region")}>{labelFor(locale, region, "region")}</option>)}
						</select>
						<p id="region-error" class="field-error"><span class="sr-only">Error.</span> <span data-error-text></span></p>
					</div>
					<div>
						<Label className="mb-1.5" htmlFor="type">{m.type}</Label>
						<select id="type" name={m.type} required class="brand-select bg-background">
							<option value="">{m.choose}</option>
							{typeOptions.map((type) => <option value={labelFor(locale, type, "type")}>{labelFor(locale, type, "type")}</option>)}
						</select>
						<p id="type-error" class="field-error"><span class="sr-only">Error.</span> <span data-error-text></span></p>
					</div>
					<div>
						<Label className="mb-1.5" htmlFor="message">{m.message}</Label>
						<Textarea id="message" name={m.message} rows={4} className="min-h-28 bg-background text-base md:text-base" />
					</div>
				</MailForm>
			</div>
		</section>
	</div>
</Base>
