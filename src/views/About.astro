---
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { ui } from "../lib/copy";
import { localePath, type Locale } from "../lib/locale";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const c = ui(locale);
const a = c.about;
---

<Base locale={locale} title={a.title} description={a.lede}>
	<PageHeader eyebrow={c.nav.about} title={a.title} lede={a.lede} />
	<div class="mx-auto grid max-w-6xl gap-12 px-5 py-14 lg:grid-cols-[minmax(0,1fr)_280px]">
		<div class="space-y-5 text-lg leading-relaxed">
			<h2 class="font-display text-3xl">{a.whoTitle}</h2>
			{a.who.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<figure class="bg-foam p-4">
			<img src="/brand/logo.jpg" alt="IDCA" width="512" height="512" class="w-full" />
			<figcaption class="mt-3 text-sm leading-relaxed text-muted">{a.logoCaption}</figcaption>
		</figure>
	</div>
	<section class="border-y border-line bg-foam">
		<div class="mx-auto max-w-6xl px-5 py-14">
			<h2 class="font-display text-3xl">{a.objectivesTitle}</h2>
			<ol class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					c.objectives.items.map(([heading, body], index) => (
						<li class="border border-line bg-paper p-5">
							<span class="font-display text-2xl text-reef">{String(index + 1).padStart(2, "0")}</span>
							<h3 class="mt-2 font-display text-2xl">{heading}</h3>
							<p class="mt-2 leading-relaxed text-muted">{body}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>
	<section class="mx-auto max-w-6xl px-5 py-14">
		<h2 class="font-display text-3xl">{a.leadershipTitle}</h2>
		<p class="mt-3 max-w-2xl text-muted">{a.leadershipLede}</p>
		<ul class="mt-8 grid gap-6 lg:grid-cols-3">
			{
				a.leaders.map(([name, role, note]) => (
					<li class="border border-line p-5">
						<h3 class="font-display text-2xl">{name}</h3>
						<p class="mt-1 text-sm font-semibold text-reef">{role}</p>
						<p class="mt-3 text-sm leading-relaxed text-muted">{note}</p>
					</li>
				))
			}
		</ul>
	</section>
	<section class="border-t border-line bg-sea text-paper">
		<div class="mx-auto max-w-3xl px-5 py-14">
			<h2 class="font-display text-3xl">{a.rebrandTitle}</h2>
			<div class="mt-5 space-y-4 text-lg leading-relaxed text-sand">
				{a.rebrand.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<a href={localePath(locale, "/news/munas-iv")} class="mt-6 inline-flex min-h-11 items-center font-semibold underline decoration-sand/60 underline-offset-4">{a.rebrandLink}</a>
		</div>
	</section>
</Base>
