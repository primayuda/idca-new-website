---
import { getEmDashEntry } from "emdash";
import Member from "../../views/Member.astro";

const slug = Astro.params.slug;
const { entry } = slug ? await getEmDashEntry("members", slug, { locale: "en" }) : { entry: null };
if (!entry) return Astro.rewrite("/404");
---

<Member locale="en" entry={entry} />
